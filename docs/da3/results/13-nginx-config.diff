--- nginx-3-baseline.conf
+++ nginx-3-resilient.conf
@@ -6,9 +6,9 @@

 upstream resume_ip_backends {
     zone resume_ip_backends 64k;
-    server backend-1:8000 max_fails=0;
-    server backend-2:8000 max_fails=0;
-    server backend-3:8000 max_fails=0;
+    server backend-1:8000 max_fails=2 fail_timeout=10s;
+    server backend-2:8000 max_fails=2 fail_timeout=10s;
