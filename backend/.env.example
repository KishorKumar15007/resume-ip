# Local Docker PostgreSQL credentials. Docker Compose passes these to the
# local postgres service only.
POSTGRES_USER=<username>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database>

# Source of truth for both the FastAPI application and Alembic.
# Local PostgreSQL example:
DATABASE_URL=postgresql+psycopg2://<username>:<password>@127.0.0.1:5433/<database>
# Cloud Run with a Cloud SQL Unix socket: set this value in deployment
# configuration, not in source control. Replace every angle-bracket value and
# URL-encode reserved characters in the password.
# DATABASE_URL=postgresql+psycopg2://<db-user>:<url-encoded-password>@/<database>?host=/cloudsql/<project>:<region>:<instance>

JWT_SECRET_KEY=<secret-key>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
