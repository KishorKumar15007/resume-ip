# Local Docker PostgreSQL credentials. Docker Compose passes these to the
# local postgres service only.
POSTGRES_USER=<username>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database>

# The owner maintains actual settings in the protected external environment file.
# Do not create or use backend/.env. This tracked file contains placeholders only.
#
# Runtime database URL. Use the pooled Neon endpoint for Neon deployments; it
# must include sslmode=require. The local PostgreSQL form remains supported.
# Local PostgreSQL example:
DATABASE_URL=postgresql+psycopg2://<username>:<password>@127.0.0.1:5433/<database>
# Neon pooled runtime example (placeholder only; URL-encode reserved password
# characters):
# DATABASE_URL=postgresql+psycopg2://<user>:<url-encoded-password>@<pooled-host>/<database>?sslmode=require

# Alembic migration URL. Use the Neon direct endpoint for Neon migrations; it
# must include sslmode=require. When omitted, Alembic accepts DATABASE_URL only
# for the local PostgreSQL hosts documented above.
# MIGRATION_DATABASE_URL=postgresql+psycopg2://<user>:<url-encoded-password>@<direct-host>/<database>?sslmode=require

# Per-process SQLAlchemy connection pool limits.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Private Cloud Storage bucket used for submitted resume PDFs. Authentication
# uses Application Default Credentials; do not configure service-account keys.
GCS_BUCKET_NAME=resume-ip-uploads

# Pub/Sub event publishing uses Application Default Credentials; do not
# configure service-account keys. Cloud Run will use its attached service identity.
GCP_PROJECT_ID=resume-ip
PUBSUB_RESUME_UPLOADED_TOPIC=resume-uploaded

# Comma-separated exact browser origins. Leave empty for local Vite proxy
# development; set the deployed frontend HTTPS URL on Cloud Run.
CORS_ALLOWED_ORIGINS=https://<frontend-cloud-run-url>

JWT_SECRET_KEY=<secret-key>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional TOTP MFA. Generate and keep the real Fernet key only in the
# owner-managed environment configuration shared by the DA3 backend services.
MFA_ENCRYPTION_KEY=<fernet-key>
MFA_ISSUER=ResumePortal
